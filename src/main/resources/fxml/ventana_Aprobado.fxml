<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane styleClass="root-oscuro" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <VBox alignment="CENTER" maxWidth="480.0" spacing="25.0" styleClass="contenedor-principal">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <!-- Icono check -->
        <StackPane styleClass="icono-check">
            <SVGPath content="M20 6L9 17l-5-5" styleClass="check-path" />
        </StackPane>

        <!-- Titulo -->
        <VBox alignment="CENTER" spacing="8.0">
            <Label styleClass="titulo" text="¡Pago Confirmado!" />
            <Label styleClass="subtitulo" text="Su transacción ha sido procesada con éxito." />
        </VBox>

        <!-- Detalles -->
        <VBox maxWidth="Infinity" spacing="14.0" styleClass="tarjeta-detalles">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="18.0" />
            </padding>

            <Label styleClass="etiqueta-seccion" text="DETALLES DE LA TRANSACCIÓN" />

            <HBox styleClass="fila-detalle">
                <StackPane HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox styleClass="fila-detalle">
                <Label styleClass="detalle-label" text="Fecha" />
                <StackPane HBox.hgrow="ALWAYS" />
                <Label fx:id="lblFecha" styleClass="detalle-valor" text="24 de Mayo, 2024" />
            </HBox>

            <HBox styleClass="fila-detalle">
                <Label styleClass="detalle-label" text="Método" />
                <StackPane HBox.hgrow="ALWAYS" />
                <Label fx:id="lblMetodo" styleClass="detalle-valor" text="    Tarjeta de Crédito (**** 4532)" />
            </HBox>

            <HBox styleClass="fila-detalle">
                <Label styleClass="detalle-label-dorado" text="Monto Total" />
                <StackPane HBox.hgrow="ALWAYS" />
                <Label fx:id="lblMonto" styleClass="detalle-valor-dorado" text="\$1,200.00" />
            </HBox>
        </VBox>

        <!-- Boton -->
        <Button fx:id="btnVolver" maxWidth="Infinity" onAction="#handleVolverInicio" styleClass="boton-dorado" text="VOLVER AL INICIO" />

    </VBox>
</StackPane>
