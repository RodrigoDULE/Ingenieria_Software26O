<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.example.CatalogController">
    <top>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Catálogo de Contenido" BorderPane.alignment="CENTER" />
    </top>
    
    <center>
        <ListView fx:id="catalogList" prefHeight="400" prefWidth="500" />
    </center>
    
    <bottom>
        <Button onAction="#handleOpenDetail" text="Editar/Publicar" BorderPane.alignment="CENTER" />
    </bottom>
</BorderPane>
