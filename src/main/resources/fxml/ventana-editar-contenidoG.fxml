<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.example.DetailController">

    <top>
        <Label text="Detalle del Contenido" />
    </top>

    <center>
        <GridPane hgap="10" vgap="10">
            <children>
                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Fecha de creación:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="dateField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="typeField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Plataforma destino:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="platformField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </children>
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="20">
            <children>
                <Button fx:id="publishButton" onAction="#handlePublish" text="Publicar" />
                <Button fx:id="editButton" onAction="#handleEdit" text="guardar" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
